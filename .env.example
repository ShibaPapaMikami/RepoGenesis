# RepoGenesis Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application
NODE_ENV=development
PORT=3000
AUTH_PROVIDER=mock
SESSION_AUDIENCE=repogenesis
CORS_ALLOW_ORIGIN=http://localhost:5173
# App (Vite)
# VITE_ORCHESTRATION_API_URL=http://127.0.0.1:8002
# VITE_REMOTE_AUTH_MODE=manual_bearer
# NEXTAUTH_SECRET is required when AUTH_PROVIDER=gugenka
# NEXTAUTH_SECRET=replace-with-random-secret
# AUTH_ALLOWED_EMAILS=alice@gugenka.co.jp,bob@gugenka.co.jp

# If external API integration is added later
# API_KEY=YOUR_API_KEY_HERE
# API_SECRET=YOUR_SECRET_HERE
