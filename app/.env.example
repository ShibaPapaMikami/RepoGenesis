# RepoGenesis app environment variables
# Leave empty to use local ZIP mode (browser-only generation).

# Enable remote orchestration API mode:
# VITE_ORCHESTRATION_API_URL=http://127.0.0.1:8002
# For Vercel BFF proxy mode, you can set:
# VITE_ORCHESTRATION_API_URL=/api/orchestration
# Auth mode for remote generation:
# - manual_bearer: show token input (current default)
# - cookie_session: use browser session cookie with credentials: include
# VITE_REMOTE_AUTH_MODE=cookie_session
# Optional runtime traceability label shown in UI:
# VITE_RELEASE_VERSION=v0.1.0

# Gugenka Auth client config (required when using cookie_session)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# Optional:
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_AUTH_ALLOWED_DOMAIN=gugenka.jp
# VITE_AUTH_APP_NAME=RepoGenesis
# VITE_AUTH_LOGIN_MESSAGE=Gugenka スタッフでログインしてください

# Vercel server-side session config (must match Render)
# NEXTAUTH_SECRET=
# SESSION_AUDIENCE=repogenesis
# AUTH_ALLOWED_EMAILS=
# AUTH_ALLOWED_DOMAINS=gugenka.jp
